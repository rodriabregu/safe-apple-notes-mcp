{
  "name": "safe-apple-notes-mcp",
  "version": "0.1.0",
  "description": "Safety-first MCP server for Apple Notes: single-note operations, human confirmation on every write, no batch destruction.",
  "type": "module",
  "license": "MIT",
  "author": "Rodrigo Alcino",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rodriabregu/safe-apple-notes-mcp.git"
  },
  "keywords": [
    "mcp",
    "apple-notes",
    "model-context-protocol",
    "macos",
    "claude"
  ],
  "bin": {
    "safe-apple-notes-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "lint": "eslint .",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "turndown": "^7.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.10.0",
    "@types/turndown": "^5.0.5",
    "eslint": "^9.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.0"
  }
}
